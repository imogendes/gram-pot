diff -ruN a/submodules/TelegramUI/Components/Chat/ChatMessageGramPotBubbleContentNode/Sources/ChatMessageGramPotBubbleContentNode.swift b/submodules/TelegramUI/Components/Chat/ChatMessageGramPotBubbleContentNode/Sources/ChatMessageGramPotBubbleContentNode.swift
